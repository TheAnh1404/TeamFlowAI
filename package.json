{
  "name": "teamflow-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "db:seed:mjs": "node scripts/db-seed.mjs",
    "db:upgrade-legacy": "node scripts/upgrade-legacy-database.mjs",
    "test:legacy-schema": "node --test --test-isolation=none scripts/tests/legacy-schema-upgrade.test.mjs",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:managed": "node --conditions=react-server --import ./scripts/register-test-typescript.mjs --test --test-isolation=none tests/*.test.ts",
    "test:ui": "tsx tests/browser/run.ts",
    "test:tracking": "node --test --test-isolation=none src/features/tracking/tests/policy.test.mjs src/features/tracking/tests/security.test.mjs",
    "test:tracking:integration": "node scripts/test-tracking-integration.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@next/env": "16.4.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "24.13.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
