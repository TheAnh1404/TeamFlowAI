# Runtime: pooled Neon PostgreSQL URL, server only.
DATABASE_URL=
# Future migrations: direct (unpooled) Neon URL; TV2 coordinates all migrations.
DATABASE_DIRECT_URL=
# Reserved for TV3; no AI provider is installed or called by this scaffold.
OPENAI_API_KEY=
OPENAI_MODEL=
# Demo identity selection is disabled unless explicitly enabled and access code set.
ENABLE_DEMO_AUTH=false
# At least 16 characters. Keep only on server; never commit real credentials.
DEMO_ACCESS_CODE=
# Optional deterministic Coordinator while the TV3 provider is unavailable.
# "mock" must be explicit; unset uses the shared TV3 provider.
TRACKING_AI_MODE=
