# Runtime: pooled Neon PostgreSQL URL, server only.
DATABASE_URL=
# Migrations: direct (unpooled) Neon URL; TV2 coordinates all migrations.
DATABASE_DIRECT_URL=
# Application public origin (e.g. http://localhost:3000)
APP_ORIGIN=http://localhost:3000
# Registration mode: "disabled", "internal" (dev/test), or "public"
AUTH_REGISTRATION_MODE=internal
# Secret used for HMAC rate-limit scope hashing (minimum 32 bytes)
AUTH_RATE_LIMIT_SECRET=
# Demo identity selection is disabled unless explicitly enabled; production refuses true.
ENABLE_DEMO_AUTH=false
# AI Providers (Gemini or OpenAI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Explicit Coordinator mode: "mock" or "real". real uses TV3 provider; errors never fall back to mock.
COORDINATOR_MODE=mock
TRACKING_AI_MODE=mock
AI_MODE=mock

# Coordinator V2. Keep scheduled side effects disabled until sandbox rollout is verified.
COORDINATOR_AUTOMATION_ENABLED=false
COORDINATOR_SERVICE_SECRET=
COORDINATOR_DAILY_AI_JOB_LIMIT=100
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
EMAIL_SANDBOX_ALLOWLIST=

# Per-user AI settings encryption key (Base64-encoded 32-byte key)
AI_SETTINGS_ENCRYPTION_KEY=
