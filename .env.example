# Runtime: pooled Neon PostgreSQL URL, server only.
DATABASE_URL=
# Migrations: direct (unpooled) Neon URL; TV2 coordinates all migrations.
DATABASE_DIRECT_URL=
# Shared TV3 AI provider; missing API key uses labeled mock output.
OPENAI_API_KEY=
OPENAI_MODEL=
# Fail on real provider errors instead of falling back to labeled mock data.
AI_STRICT_REAL=true
# Demo identity selection is disabled unless explicitly enabled and access code set.
ENABLE_DEMO_AUTH=false
# At least 16 characters. Keep only on server; never commit real credentials.
DEMO_ACCESS_CODE=
# Optional deterministic Coordinator while the TV3 provider is unavailable.
# "mock" must be explicit; unset uses the shared TV3 provider.
TRACKING_AI_MODE=
# Optional local rehearsal mode. Data stays under .cache/<DEMO_DATABASE_NAME>.
# demo:setup and demo:start select local-demo explicitly; normal runtime defaults to Neon.
TEAMFLOW_DATABASE_MODE=neon
DEMO_DATABASE_NAME=stage-demo
# Deterministic rehearsal AI, always labeled mock. demo:start enables this explicitly.
AI_FORCE_MOCK=false
# Local rehearsal scans in the web process. Neon uses npm run worker:deadlines separately.
LOCAL_DEMO_DEADLINE_WORKER=false
DEADLINE_SCAN_INTERVAL_MS=5000
# Base64-encoded 32-byte encryption key for saved per-user AI credentials on hosted servers.
# Local-demo uses a private key under .cache/private-ai; never commit or publish it.
AI_SETTINGS_ENCRYPTION_KEY=
